# Terraform working directories (providers, modules, backend cache)
**/.terraform/*

# State files and backups: never commit
*.tfstate
*.tfstate.*

# Saved plan files (contain state data)
tfplan
*.tfplan

# Variable files (may contain sensitive values); *.tfvars.example is not matched
*.tfvars
*.tfvars.json

# Shared backend settings (environment-specific)
backend.hcl

# Crash logs
crash.log
crash.*.log

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration
.terraformrc
terraform.rc
